# Store text as LF in the repo AND check it out as LF on every platform.
# (These sources are pasted into Ignition, which is line-ending agnostic; forcing LF
#  stops Windows CRLF churn and keeps _ingest_zip.py output diff-clean.)
* text=auto eol=lf

# Treat these as binary (no line-ending munging, no diff noise)
*.xlsm binary
*.xlsx binary
*.docx binary
*.zip  binary
*.pdf  binary
*.gwbk binary
